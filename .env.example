# ==========================================
# CẤU HÌNH HỆ THỐNG GAME 2D LỚP HỌC TIKTOK LIVE
# ==========================================

# Server Port
PORT=3000
NODE_ENV=development

# ------------------------------------------
# CƠ SỞ DỮ LIỆU MICROSOFT SQL SERVER
# ------------------------------------------
# DB_TYPE: 'mssql' (kết nối Microsoft SQL Server) hoặc 'memory' / 'sqlite' (chế độ demo tức thì)
DB_TYPE=mssql
DB_SERVER=localhost
DB_PORT=1433
DB_USER=sa
DB_PASSWORD=YourStrongPassword123
DB_NAME=ClassroomLiveDB
DB_ENCRYPT=false
DB_TRUST_SERVER_CERTIFICATE=true

# ------------------------------------------
# KẾT NỐI TIKTOK LIVE
# ------------------------------------------
# Chế độ kết nối: 'mock' (giả lập/thử nghiệm) hoặc 'live' (kết nối trực tiếp phòng LIVE)
TIKTOK_CONNECT_MODE=mock
TIKTOK_USERNAME=your_tiktok_account

# ------------------------------------------
# GIỌNG ĐỌC AI & TEXT-TO-SPEECH (TTS)
# ------------------------------------------
TTS_PROVIDER=web
TTS_SPEED=1.0
TTS_PITCH=1.0
TTS_DEFAULT_VOICE=female

# ------------------------------------------
# GOOGLE GEMINI AI (Tạo câu hỏi tự động)
# ------------------------------------------
GEMINI_API_KEY=

# ------------------------------------------
# CẤU HÌNH TIẾT HỌC & TỰ ĐỘNG TREO LIVE (AUTOPILOT)
# ------------------------------------------
ADMIN_SECRET=admin123
MAX_CLASS_CAPACITY=40
QUESTION_DURATION=20
PERIOD_DURATION=600
RECESS_DURATION=20
REVEAL_DELAY=6
AUTOPILOT=true
